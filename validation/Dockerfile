# Validation sandbox for recipes generated by spack-it-2.
#
# The tag pins both Spack and the upstream spack-packages repository it
# bundles, so every validation run is performed against a fresh, immutable
# upstream. Tier-3 (spack install) would add baked bootstrap compilers here.
FROM docker.io/spack/ubuntu-noble:1.2.2

# The parent image entrypoint wraps commands with Spack's docker-shell; the
# validator needs a plain entrypoint instead and sources setup-env.sh itself.
COPY validate.sh /opt/validate.sh

ENTRYPOINT ["/bin/bash", "/opt/validate.sh"]
